APP_NAME=VetSaaS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# Superadmin de la plataforma VetSaaS (tabla platform_admins, guard platform)
PLATFORM_SUPERADMIN_NAME="Super administrador"
PLATFORM_SUPERADMIN_EMAIL=
PLATFORM_SUPERADMIN_PASSWORD=

# Solo al migrar el tenant: schema PostgreSQL destino (ver database/migrations/tenant/README.md)
# TENANT_MIGRATION_SCHEMA=vet_a1b2c3

# Tests Pest que ejecutan `vetsaas:tenant-migrate` / `migrate:fresh` contra Postgres: omiten la suite
# si DB_DATABASE no termina en `_test` o `_testing` (p. ej. usa `vetsaas_test`, no la misma que desarrollo).
# VETSAAS_ALLOW_TENANT_MIGRATE_TESTS=false

# Integración Orvae PE -> VetSaaS (provisioning firmado HMAC, igual que Aula Virtual)
# El mismo secret debe estar en Orvae PE como AULAVIRTUAL_PROVISION_HMAC_SECRET
# (o el equivalente VETSAAS_PROVISION_HMAC_SECRET cuando se lance la integración VetSaaS).
ORVAE_PROVISION_HMAC_SECRET=
ORVAE_PROVISION_MAX_SKEW_SECONDS=300
ORVAE_PROVISION_IDEMPOTENCY_TTL_DAYS=30

# Dominio base donde cada tenant tiene su subdominio (slug.{VETSAAS_TENANT_DOMAIN})
VETSAAS_TENANT_SCHEME=https
VETSAAS_TENANT_DOMAIN=vetsaas.orvae.pe
VETSAAS_TENANT_LOGIN_PATH=/login

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Backups PostgreSQL (vetsaas:backup-database, diario 02:00 vía schedule)
BACKUP_ENABLED=true
# BACKUP_PATH=/var/backups/vetsaas
# Tras cada backup (y con --prune-only) se borran carpetas locales y en R2/S3
# más antiguas que este umbral. Mantener ≤14 para el free tier de R2.
BACKUP_RETENTION_DAYS=14
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_STALE_AFTER_HOURS=30

# Copia offsite (S3 o Cloudflare R2). Sin esto, los dumps solo viven en el VPS.
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_DISK=backups
BACKUP_REMOTE_PREFIX=vetsaas/db
BACKUP_REMOTE_REQUIRED=true

BROADCAST_CONNECTION=log

# --- Laravel Reverb (WebSockets chat interno) ---
# Local recomendado:
#   1) BROADCAST_CONNECTION=reverb
#   2) php artisan reverb:start
#   3) Vite con VITE_REVERB_* (o props Inertia `broadcast` del chat)
# REVERB_APP_ID=vetsaas
# REVERB_APP_KEY=local-key
# REVERB_APP_SECRET=local-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# false = reset de contraseña se envía en el request (recomendado sin worker de colas)
MAIL_QUEUE_AUTH_NOTIFICATIONS=false
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (ejemplo): mismo driver S3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=vetsaas-backups
# AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
# BACKUP_REMOTE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

# ── Multi-tenancy en runtime ──
# Hosts que NO son tenants (panel del superadmin)
TENANT_CENTRAL_DOMAINS="localhost,127.0.0.1,vetsaas.test"
# Sufijo desde el cual se extrae el slug del subdominio
TENANT_ROOT_DOMAIN=vetsaas.test
# Prefijo obligatorio en schema_name. Vacío = sin restricción.
TENANT_SCHEMA_PREFIX=vet_
# Segundos de cache para la resolución tenant → schema. 0 = sin cache.
TENANT_CACHE_TTL=60

# API SUNAT / RUC (apiperu.dev) — solo servidor; consulta DNI/RUC al registrar propietario/proveedor
APIPERU_BASE_URL=https://apiperu.dev/api
APIPERU_TOKEN=

# Lucode / APISUNAT — respaldo si apiperu agota cuota (token de app.apisunat.pe → Organización → API Token)
# Si se omite, se usa el token APISUNAT configurado en la clínica (Configuración › General).
APISUNAT_LOOKUP_BASE_URL=https://dev.apisunat.pe/api/v1
APISUNAT_LOOKUP_TOKEN=

# OpenWA — gateway WhatsApp self-hosted (wa.vetsaas.orvae.pe)
OPENWA_ENABLED=false
OPENWA_API_URL=https://wa.vetsaas.orvae.pe
OPENWA_API_KEY=
OPENWA_ADMIN_URL=https://wa-admin.vetsaas.orvae.pe
OPENWA_TIMEOUT_SECONDS=45
OPENWA_QUEUE_MAX_ATTEMPTS=3
OPENWA_PLATFORM_SESSION_NAME=vetsaas-platform

# Recordatorios de renovación de suscripción (WhatsApp plataforma → tenant)
BILLING_RENEWAL_REMINDER_DAYS=7,3,1
# Checkout Orvae: base o plantilla con {tenant} {plan} {ciclo}
ORVAE_RENEWAL_URL=https://orvae.pe/renovar/vetsaas?tenant={tenant}&plan={plan}&ciclo={ciclo}

# OpenAI — Bot IA WhatsApp, SalesBot e asistente in-app (ayuda + consulta)
OPENAI_API_KEY=
# IN_APP_ASSISTANT_ENABLED=true
# IN_APP_ASSISTANT_OPENAI_MODEL=gpt-4o-mini
# IN_APP_ASSISTANT_DAILY_LIMIT=40

# Google Calendar + Meet (SalesBot tours 15–20 min)
# Client ID/Secret del OAuth "Aplicación web" en Google Cloud (proyecto Vetsaas).
# Redirect URI debe coincidir exactamente con Cloud Console.
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/google/oauth/callback"
# GOOGLE_CALENDAR_TIMEZONE=America/Lima
# GOOGLE_CALENDAR_MEETING_MINUTES=20
# Opcional: refresh token manual (si no conectas desde el panel)
# GOOGLE_CALENDAR_REFRESH_TOKEN=

# WhatsApp personal al confirmar Meet (formato 519XXXXXXXX)
SALESBOT_MEET_NOTIFY_WHATSAPP=51976709811

# Web Push (campana superadmin). Generar con:
# php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
VAPID_SUBJECT="mailto:soporte@orvae.pe"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Asistente IA — activación del add-on vía WhatsApp soporte
BOT_IA_ACTIVATION_WHATSAPP_PHONE=51976809804
BOT_IA_ACTIVATION_WHATSAPP_DISPLAY="976 809 804"
BOT_IA_WEBHOOK_CIRCUIT_ENABLED=true
BOT_IA_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
BOT_IA_WEBHOOK_CIRCUIT_TTL_SECONDS=300
BOT_IA_OPS_LOAD_ALERT_THRESHOLD=4
BOT_IA_LID_CONTACT_CACHE_TTL_SECONDS=86400

# AlmaPet ID / PetPass — bridge de registro de microchip
PETPASS_ENABLED=false
PETPASS_BASE_URL=https://almapetid.com
PETPASS_HANDOFF_SECRET=
PETPASS_WEBHOOK_SECRET=
# PETPASS_HANDOFF_PATH=/api/v1/handoff
# PETPASS_HTTP_TIMEOUT=15

# Wizard de configuración inicial (clínicas)
# ONBOARDING_ENABLED=true activa el wizard para todos los tenants incompletos.
# ONBOARDING_ENABLED_SLUGS permite probar solo en tenants concretos (ej. demo,mi-prueba).
ONBOARDING_ENABLED=false
ONBOARDING_ENABLED_SLUGS=
ONBOARDING_PREVIEW=false
